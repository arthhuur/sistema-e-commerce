# Copie este arquivo para ".env.local" e ajuste os valores.
# O ".env.local" nunca vai para o Git (está no .gitignore).

# Onde a API (apps/backend) está rodando.
#
# Em desenvolvimento não é preciso definir nada: sem esta variável, o front
# já assume "http://localhost:3000", que é onde a API sobe na sua máquina.
#
# Em produção (Render), aponte para a URL pública do serviço da API.
# Sem barra no final.
#
# Exemplo: BACKEND_URL=https://payment-router-api.onrender.com
BACKEND_URL=http://localhost:3000
