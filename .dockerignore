# Dependências e artefatos de build: reconstruídos dentro da imagem.
node_modules
**/node_modules
dist
**/dist
**/*.tsbuildinfo

# Testes e configuração de teste não entram na imagem de produção.
**/test
**/vitest.config*.ts

# Documentação e metadados do repositório.
*.md
**/*.md
.git
.gitattributes
.gitignore

# Segredos nunca entram na imagem (em produção as variáveis vêm do painel).
.env
**/.env
.env.*

# Arquivos que só fazem sentido fora do container.
Dockerfile
.dockerignore
docker-compose.yml
**/.oxlintrc.json
**/.prettierrc
