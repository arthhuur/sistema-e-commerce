{
  "name": "payment-router",
  "version": "0.0.1",
  "description": "Monorepo do Payment Router: API NestJS (apps/backend) e, adiante, a interface Next.js (apps/web).",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace apps/backend",
    "lint": "npm run lint --workspace apps/backend",
    "format": "npm run format --workspace apps/backend",
    "test": "npm run test --workspace apps/backend",
    "test:watch": "npm run test:watch --workspace apps/backend",
    "test:cov": "npm run test:cov --workspace apps/backend",
    "test:debug": "npm run test:debug --workspace apps/backend",
    "test:e2e": "npm run test:e2e --workspace apps/backend",
    "start": "npm run start --workspace apps/backend",
    "start:dev": "npm run start:dev --workspace apps/backend",
    "start:debug": "npm run start:debug --workspace apps/backend",
    "start:prod": "npm run start:prod --workspace apps/backend",
    "migration:generate": "npm run migration:generate --workspace apps/backend --",
    "migration:run": "npm run migration:run --workspace apps/backend",
    "migration:revert": "npm run migration:revert --workspace apps/backend",
    "seed:user": "npm run seed:user --workspace apps/backend --",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "lint:web": "npm run lint --workspace apps/web",
    "typecheck:web": "npm run typecheck --workspace apps/web"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
