# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" nunca vai para o Git (está no .gitignore).

# --- Aplicação ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (Fase 2) ---
# Há DUAS formas de apontar para o banco. Use uma.

# FORMA 1 — String de conexão única.
# É o formato que o Neon (e o Supabase/Railway) entrega pronto no painel, em
# "Connection string". Descomente as duas linhas e cole a SUA string.
# Enquanto POSTGRES_URL existir, ela tem prioridade e os campos soltos da
# Forma 2 são ignorados.
# POSTGRES_URL=postgresql://usuario:senha@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# POSTGRES_SSL=true

# FORMA 2 — Campos soltos. É o que faz sentido no banco local.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payment_router
POSTGRES_PASSWORD=payment_router
POSTGRES_DB=payment_router

# --- Banco dos TESTES ---
# A suíte APAGA as tabelas entre um caso e outro, então este banco é SEPARADO
# do de desenvolvimento e fica SEMPRE na sua máquina.
# NUNCA aponte estas variáveis para o Neon: o TRUNCATE apagaria o banco
# hospedado. É por isso que elas não têm o mesmo nome das de cima.
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5432
POSTGRES_TEST_USER=payment_router
POSTGRES_TEST_PASSWORD=payment_router
POSTGRES_TEST_DB=payment_router_test

# --- Redis (Fase 2: idempotência e filas) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Gateways de pagamento (sandbox, Fase 4) ---
# NUNCA coloque credenciais de produção aqui.
MERCADO_PAGO_ACCESS_TOKEN=
PAGBANK_TOKEN=

# --- NestJS Observe (Observabilidade) ---
# Obtenha estas chaves rodando 'npx @nestjs/observe link'
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Segurança da sessão ---

# Segredo que assina os tokens de acesso. É a chave do reino: quem o conhece
# consegue forjar um token de "gerente" sem precisar de senha nenhuma, e a API
# acredita, porque a assinatura confere.
#
# Gere um NOVO e diferente para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Fora de desenvolvimento (NODE_ENV=development|test) a aplicação se RECUSA a
# subir sem esta variável. É proposital: uma API fora do ar aparece no
# primeiro minuto; uma API com segredo público pode passar meses sem ninguém
# notar. Mínimo de 32 caracteres.
JWT_SECRET=

# Chave OPCIONAL (mas recomendada) para cifrar os segredos do 2FA (TOTP).
#
# O segredo que gera os códigos de 6 dígitos de cada usuário fica guardado
# CIFRADO (AES-256-GCM) no banco — nunca em texto puro. Se esta variável não
# existir, a chave de cifra é DERIVADA do JWT_SECRET por HKDF.
#
# O motivo de existir uma variável separada: girar (rotacionar) o JWT_SECRET
# sem isto tornaria os segredos do 2FA irrecuperáveis — e todo mundo perderia
# o acesso ao autenticador de uma vez. Com uma chave dedicada, dá para trocar o
# JWT_SECRET sem mexer no 2FA. Os códigos de recuperação continuam valendo em
# qualquer caso, porque são HASH (SHA-256), não cifra.
#
# Gere um valor forte e diferente por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Se preencher, use ao menos 32 caracteres.
MFA_SECRET_KEY=

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
#
# Em PRODUÇÃO isto é obrigatório: sem esta variável nenhuma origem externa é
# aceita e o front simplesmente não conecta. O padrão é negar — um erro
# barulhento é melhor que um silencioso.
#
# Em desenvolvimento, deixe em branco: o padrão já libera o localhost.
#
# Exemplo: CORS_ORIGINS=https://seu-front.vercel.app
CORS_ORIGINS=

# Como o cookie de sessão viaja entre sites diferentes.
#
#   lax  -> PADRÃO, e o recomendado. Serve quando o front publica a API no
#           próprio domínio (por exemplo, o Next.js reescrevendo /api para o
#           Render). É mais seguro e não depende de cookie de terceiros, que
#           Safari e Chrome já bloqueiam.
#   none -> só quando o front e a API ficam mesmo em domínios diferentes e
#           não há reescrita. Exige HTTPS nos dois lados.
#
# COOKIE_SAME_SITE=lax
